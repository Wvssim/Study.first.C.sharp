@model List<MyMarket.Models.Product>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Panier";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">🛒 Mon panier</h2>
        <a href="/Products" class="btn btn-outline-secondary">⬅️ Continuer mes achats</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info shadow-sm text-center py-4">
            <h5>Votre panier est vide 🛍️</h5>
            <p class="mb-0">Ajoutez des produits pour commencer vos achats.</p>
        </div>
    }
    else
    {
        <div class="card shadow-lg border-0">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Produits dans le panier</h5>
                <a href="/Cart/ClearCart" class="btn btn-warning btn-sm">🗑️ Vider le panier</a>
            </div>

            <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Nom</th>
                            <th>Description</th>
                            <th>Prix (DH)</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Description</td>
                                <td>@item.Price</td>
                                <td>
                                    <a asp-controller="Cart"
                                       asp-action="RemoveFromCart"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">
                                        ❌ Supprimer
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <a href="#" class="btn btn-success btn-lg">
                ✅ Passer la commande
            </a>
        </div>
    }
</div>
