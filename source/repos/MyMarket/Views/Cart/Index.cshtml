@model List<MyMarket.Models.CartItem>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Panier";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">🛒 Mon panier</h2>
        <a href="/Products" class="btn btn-outline-secondary">⬅️ Continuer mes achats</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info shadow-sm text-center py-4">
            <h5>Votre panier est vide 🛍️</h5>
            <p class="mb-0">Ajoutez des produits pour commencer vos achats.</p>
        </div>
    }
    else
    {
        decimal total = Model.Sum(i => i.Product.Price * i.Quantity);

        <div class="card shadow-lg border-0">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Produits dans le panier</h5>
                <a href="/Cart/ClearCart" class="btn btn-warning btn-sm">🗑️ Vider le panier</a>
            </div>

            <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Nom</th>
                            <th>Quantité</th>
                            <th>Prix (DH)</th>
                            <th>Total</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Product.Name</td>

                                <td>
                                    <!-- Boutons quantité -->
                                    <a class="btn btn-sm btn-outline-primary" href="/Cart/AddToCart/@item.Product.Id">+</a>
                                    <span class="mx-2">@item.Quantity</span>
                                    <a class="btn btn-sm btn-outline-primary" href="/Cart/RemoveOne/@item.Product.Id">-</a>
                                </td>

                                <td>@item.Product.Price</td>

                                <td>
                                    @(@item.Product.Price* item.Quantity)
                                </td>

                                <td>
                                    <a asp-controller="Cart"
                                       asp-action="RemoveFromCart"
                                       asp-route-id="@item.Product.Id"
                                       class="btn btn-danger btn-sm">
                                        ❌
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TOTAL + PASSER COMMANDE -->
        <div class="d-flex justify-content-end mt-4">
            <div class="text-end">
                <h4 class="fw-bold">💵 Total : @total DH</h4>

                <form asp-action="Checkout" method="post">
                    <button type="submit" class="btn btn-success btn-lg mt-3">
                        ✅ Passer la commande
                    </button>
                </form>
            </div>
        </div>
    }
</div>
