@model List<MyMarket.Models.Product>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <h2 class="text-primary fw-bold mb-4">⚙️ Tableau de bord administrateur</h2>

    <div class="row mb-4">
        <!-- Carte 1 : Total produits -->
        <div class="col-md-3 mb-3">
            <div class="card text-center shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title text-muted">Produits</h5>
                    <h3 class="text-primary fw-bold">@Model.Count()</h3>
                </div>
            </div>
        </div>

        <!-- Carte 2 : Utilisateurs -->
        <div class="col-md-3 mb-3">
            <div class="card text-center shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title text-muted">Utilisateurs</h5>
                    <h3 class="text-success fw-bold">@ViewBag.UserCount</h3>
                </div>
            </div>
        </div>

        <!-- Carte 3 : Stock total -->
        <div class="col-md-3 mb-3">
            <div class="card text-center shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title text-muted">Stock total</h5>
                    <h3 class="text-warning fw-bold">@Model.Sum(p => p.Stock)</h3>
                </div>
            </div>
        </div>

        <!-- Carte 4 : Prix moyen -->
        <div class="col-md-3 mb-3">
            <div class="card text-center shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title text-muted">Prix moyen</h5>
                    <h3 class="text-danger fw-bold">
                        @Math.Round(@Model.Average(p => p.Price), 2) DH
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Liens rapides -->
    <div class="d-flex justify-content-end mb-3">
        <a href="/Products/Create" class="btn btn-success me-2">➕ Ajouter un produit</a>
        <a href="/Admin/Users" class="btn btn-primary">👥 Gérer les utilisateurs</a>
    </div>

    <!-- Liste des produits -->
    <div class="card shadow-lg border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">📦 Liste des produits</h4>
            <a href="/Products/Create" class="btn btn-light btn-sm">➕ Nouveau</a>
        </div>

        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Nom</th>
                        <th>Description</th>
                        <th>Prix</th>
                        <th>Stock</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>@product.Id</td>
                            <td>@product.Name</td>
                            <td>@(product.Description?.Length > 50 ? product.Description.Substring(0, 50) + "..." : product.Description)</td>
                            <td>@product.Price DH</td>
                            <td>@product.Stock</td>
                            <td>
                                <a href="/Products/Edit/@product.Id" class="btn btn-warning btn-sm">✏️ Modifier</a>
                                <a href="/Products/Delete/@product.Id" class="btn btn-danger btn-sm"
                                   onclick="return confirm('Supprimer ce produit ?');">🗑️ Supprimer</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 10px;
        transition: 0.2s ease-in-out;
    }

        .card:hover {
            transform: scale(1.02);
        }

    .table th, .table td {
        vertical-align: middle !important;
    }

    .btn {
        border-radius: 8px;
    }
</style>
