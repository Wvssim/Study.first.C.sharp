@model MyMarket.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">🛍️ @Model.Name</h2>

    <div class="card shadow-sm p-4">
        <div class="row">
            <div class="col-md-5">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded">
            </div>
            <div class="col-md-7">
                <h4>@Model.Name</h4>
                <p class="text-muted">@Model.Description</p>
                <p><strong>Price:</strong> @Model.Price DH</p>
                <p><strong>Category:</strong> @Model.Category</p>

                <div class="mt-4">
                    <a href="@Url.Action("Index", "Products")" class="btn btn-secondary me-2">
                        ← Retour à la liste
                    </a>

                    <form asp-action="AddToCart" asp-controller="Cart" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-success">
                            🛒 Ajouter au panier
                        </button>
                    </form>


                </div>
            </div>
        </div>
    </div>
</div>
