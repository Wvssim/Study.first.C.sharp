@model MyMarket.Models.Product

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Ajouter un produit";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">➕ Ajouter un nouveau produit</h4>
            <a href="/Admin/Dashboard" class="btn btn-light btn-sm">⬅️ Retour</a>
        </div>

        <div class="card-body">
            <form asp-action="Create" asp-controller="Admin" method="post">

                <!-- Nom -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Nom du produit :</label>
                    <input asp-for="Name" class="form-control" placeholder="Ex: AirPods Pro 2" required />
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Description :</label>
                    <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
                </div>

                <!-- Prix + Stock -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label fw-bold">Prix (DH) :</label>
                        <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Stock" class="form-label fw-bold">Stock :</label>
                        <input asp-for="Stock" type="number" min="0" class="form-control" required />
                    </div>
                </div>

                <!-- Catégorie -->
                <div class="mb-3">
                    <label asp-for="Category" class="form-label fw-bold">Catégorie :</label>
                    <select asp-for="Category" class="form-select" required>
                        <option value="">-- Sélectionnez une catégorie --</option>
                        <option>Électronique</option>
                        <option>Informatique</option>
                        <option>Accessoires</option>
                        <option>Autres</option>
                    </select>
                </div>

                <!-- Image (Lien URL) -->
                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label fw-bold">Lien de l'image :</label>
                    <input asp-for="ImageUrl" type="url" class="form-control" placeholder="https://exemple.com/image.jpg" required />
                    <img id="preview" src="" class="img-thumbnail mt-2" style="width:150px; display:none;" />
                </div>

                <div class="mt-4 d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-success">✅ Ajouter le produit</button>
                    <a href="/Admin/Dashboard" class="btn btn-secondary">❌ Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // 🖼️ Aperçu automatique de l'image saisie
        document.querySelector('[name="ImageUrl"]').addEventListener('input', e => {
            const img = document.getElementById('preview');
            if (e.target.value.startsWith('http')) {
                img.src = e.target.value;
                img.style.display = 'block';
            } else {
                img.style.display = 'none';
            }
        });
    </script>
}
