@model MyMarket.Models.Product

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Modifier un produit";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
            <h4 class="mb-0 fw-bold">✏️ Modifier le produit</h4>
            <a href="/Admin/Dashboard" class="btn btn-dark btn-sm">⬅️ Retour</a>
        </div>

        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Nom du produit :</label>
                    <input asp-for="Name" class="form-control" placeholder="Ex: AirPods Pro 2" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label fw-bold">Prix (DH) :</label>
                    <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" required />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Description :</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Description du produit" required></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Stock" class="form-label fw-bold">Stock :</label>
                    <input asp-for="Stock" type="number" min="0" class="form-control" required />
                    <span asp-validation-for="Stock" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="submit" class="btn btn-success">💾 Mettre à jour</button>
                    <a href="/Admin/Dashboard" class="btn btn-secondary">❌ Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .card {
        border-radius: 12px;
    }

    .form-control {
        border-radius: 8px;
    }

    .btn {
        border-radius: 10px;
        font-weight: 500;
    }

    .card-header h4 {
        letter-spacing: 0.3px;
    }
</style>
