@model IEnumerable<MyMarket.Models.Product>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard Admin";
}

<div class="container mt-5">
    <!-- En-tête du tableau de bord -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">📊 Tableau de bord administrateur</h2>
        <div>
            <a href="/Admin/ManageUsers" class="btn btn-outline-primary me-2">👥 Gérer les utilisateurs</a>
            <a href="/Admin/Create" class="btn btn-success me-2">➕ Ajouter un produit</a>
            <a href="/Admin/Logout" class="btn btn-outline-danger">🚪 Déconnexion</a>
        </div>
    </div>

    <!-- Message de bienvenue -->
    <div class="alert alert-info shadow-sm mb-4">
        Bienvenue dans votre tableau de bord ! Vous pouvez gérer vos produits ici.
    </div>

    <!-- Tableau des produits -->
    <div class="card shadow-lg border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">🧾 Liste des produits</h5>
            <a href="/Admin/Create" class="btn btn-light btn-sm">+ Nouveau produit</a>
        </div>

        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Prix (DH)</th>
                            <th>Description</th>
                            <th class="text-center" style="width:180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td class="fw-semibold">@item.Name</td>
                                <td class="text-success fw-bold">@item.Price</td>
                                <td>@item.Description</td>

                                <td class="text-center">

                                    <!-- Bouton Modifier -->
                                    <a href="/Admin/Edit/@item.Id" class="btn btn-warning btn-sm me-2">
                                        ✏️ Modifier
                                    </a>

                                    <!-- Bouton Supprimer (POST Sécurisé) -->
                                    <form asp-controller="Products"
                                          asp-action="DeleteConfirmed"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          style="display:inline;"
                                          onsubmit="return confirm('Voulez-vous vraiment supprimer ce produit ?');">

                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">🗑️ Supprimer</button>

                                    </form>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    Aucun produit disponible pour le moment.
                </div>
            }
        </div>
    </div>
</div>

<!-- Styles optionnels -->
<style>
    h2 {
        letter-spacing: 0.5px;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
        transition: background-color 0.3s;
    }

    .btn {
        border-radius: 10px;
        font-weight: 500;
    }

    .card {
        border-radius: 12px;
    }
</style>
